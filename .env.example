# Generate a long random value before exposing the app outside localhost.
# povinné: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret
# Set true only when the app is behind HTTPS (for example Caddy).
SESSION_COOKIE_SECURE=false
PROCESSLOG_PORT=8000
# SSH alias available on the Docker host; this account must be allowed to reach spc-vm.
CYCLEDES_SSH_TARGET=spc-vm
# lokální vývoj bez Authentiku (jen s FLASK_DEBUG=1): dosadí SSO hlavičky
# SSO_DEV_USER=admin
# SSO_DEV_GROUPS=spc-users|processlog-admin
